// use prisma-8

enum QuestionType {
  open
  multiple-choice
}

enum UserRole {
  recipient
  creator
}

enum  Status {
  active
  closed
}

model Users {
  uuid String @id @default(uuid())

  email String @unique
  username String @unique
  userRole UserRole
 
  questions Questions[]
  answers Answers[]

  CreatedSessions Sessions[] @relation("CreatedSessions")
  JoinedSessions Sessions[] @relation("JoinedSessions")

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Questions {
  uuid String @id @default(uuid())

  title String
  type QuestionType
  options String[]?
  category String?

  user Users @relation(fields: [user_id], references: [uuid])
  user_id String @default(uuid())

  session Sessions? @relation(fields: [session_id], references: [uuid])
  session_id String?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
 
}

model Answers {
  uuid String @id @default(uuid())

  question_id String
  text_answer String?
  selected_option String?

  question Questions @relation(fields: [question_id], references: [uuid])

  user Users @relation(fields: [user_id], references: [uuid])
  user_id String @default(uuid())

  submittedAt TimestamptzString @default(now())
  createdAt   TimestamptzString @default(now())

}

model Sessions {
  uuid        String   @id @default(uuid())
  slug        String   @unique
  status      Status   @default(active)

  creator     Users    @relation("CreatedSessions", fields: [creatorId], references: [uuid])
  creatorId   String

  recipientId String?
  recipient   Users?   @relation("JoinedSessions", fields: [recipientId], references: [uuid])

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
  expiresAt   DateTime?

  // relationship
  questions   Questions[]
}



